#!/usr/bin/env bash
# Stub for wget: logs the invocation and creates an empty file at the -O path.
# When a golangci-lint checksums file is requested, real checksums of the
# (empty) tarballs already downloaded next to it are written so the script's
# sha256 verification passes.
# shellcheck source=tests/lint-project/stubs/lib.sh
. "$STUB_STUBS_DIR/lib.sh"
stub_log wget "$@"

out=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -O) out="$2"; shift ;;
    esac
    shift
done
[[ -n "$out" ]] || exit 0

if [[ "$out" == *checksums.txt ]]; then
    dir=$(dirname "$out")
    : > "$out"
    for tgz in "$dir"/*.tar.gz; do
        [[ -f "$tgz" ]] || continue
        if command -v sha256sum > /dev/null 2>&1; then
            sum=$(sha256sum "$tgz" | cut -d' ' -f1)
        else
            sum=$(shasum -a 256 "$tgz" | cut -d' ' -f1)
        fi
        echo "$sum  $(basename "$tgz")" >> "$out"
    done
else
    : > "$out"
fi
exit 0
