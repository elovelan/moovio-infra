#!/usr/bin/env bash
# Stub for the go toolchain: logs the invocation and returns canned output for
# the subcommands lint-project.sh inspects. Fixture knobs come from STUB_* env
# vars set in the case file.
# shellcheck source=tests/lint-project/stubs/lib.sh
. "$STUB_STUBS_DIR/lib.sh"
stub_log go "$@"

mod="${STUB_MODNAME:-github.com/moov-io/example}"

case "$*" in
    "version")
        echo "go version go1.24.1 linux/amd64"
        ;;
    "list .")
        echo "$mod"
        ;;
    "list ./...")
        printf '%s\n' "$mod" "$mod/pkg/a" "$mod/cmd/b"
        ;;
    "mod why")
        printf '# %s\n%s\n' "$mod" "$mod"
        ;;
    "mod why "*)
        dep="$3"
        echo "# $dep"
        if [[ " ${STUB_UNUSED_RETRACTED:-} " == *" $dep "* ]]; then
            echo "(main module does not need package $dep)"
        else
            printf '%s\n%s\n' "$mod" "$dep"
        fi
        ;;
    "list -m all")
        echo "$mod"
        echo "github.com/moov-io/base v0.50.0"
        if [[ -n "${STUB_MOOVFINANCIAL_DEP:-}" ]]; then
            echo "github.com/moovfinancial/private v1.0.0"
        fi
        ;;
    "list -m -u all")
        echo "$mod"
        echo "github.com/moov-io/base v0.50.0"
        for dep in ${STUB_RETRACTED:-}; do
            echo "$dep v0.1.0 (retracted) [v0.2.0]"
        done
        ;;
    "list -m -u -json "*)
        printf '{"Path": "%s"}\n' "$5"
        ;;
    "env GOPATH")
        echo "$STUB_GOPATH"
        ;;
    "tool cover -func="*)
        printf 'github.com/x/y/a.go:1:\tFoo\t100.0%%\ntotal:\t(statements)\t%s%%\n' "${STUB_COVERAGE:-87.5}"
        ;;
    "test "*)
        for arg in "$@"; do
            case "$arg" in
                -coverprofile=*)
                    profile="${arg#-coverprofile=}"
                    mkdir -p "$(dirname "$profile")"
                    printf 'mode: atomic\n%s/a.go:1.1,2.2 1 1\n' "$mod" > "$profile"
                    ;;
            esac
        done
        ;;
    "build "*|"install "*|"mod tidy"|"mod vendor")
        ;;
    *)
        echo "go stub: unhandled invocation: go $*" >&2
        exit 1
        ;;
esac
exit 0
